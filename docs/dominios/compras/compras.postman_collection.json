  "item": [
    {
      "name": "00 — Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Autentica com usuário/senha e guarda o `accessToken` na coleção.\n\nSe o usuário tiver 2FA ativo a resposta é `PENDING_2FA`: preencha a variável `totpCode` e rode a requisição seguinte.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "",
                  "if (json.status === 'PENDING_2FA') {",
                  "    pm.collectionVariables.set('challengeToken', json.challengeToken);",
                  "    console.warn('2FA ativo — preencha {{totpCode}} e rode \"Login 2FA — concluir\".');",
                  "} else {",
                  "    pm.test('Retorna accessToken e refreshToken', () => {",
                  "        pm.expect(json.accessToken, 'accessToken').to.be.a('string').and.not.empty;",
                  "        pm.expect(json.refreshToken, 'refreshToken').to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('tokenType = Bearer', () => pm.expect(json.tokenType).to.eql('Bearer'));",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "    pm.collectionVariables.set('challengeToken', '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login 2FA — concluir",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "2fa",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeToken\": \"{{challengeToken}}\",\n  \"code\": \"{{totpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Só é necessária quando o login devolve `PENDING_2FA`. É ignorada automaticamente quando não há challenge pendente.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('challengeToken')) {",
                  "    console.log('Sem challenge de 2FA pendente — requisição ignorada.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.collectionVariables.set('challengeToken', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil e permissões do usuário logado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Confere se o token funciona e se o usuário tem as permissões exigidas por Compras. Guarda a lista em `{{permissions}}` para as requisições que dependem de permissões DEV."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const perms = json.permissions || [];",
                  "pm.collectionVariables.set('permissions', JSON.stringify(perms));",
                  "",
                  "const required = [\"COMPRAS_READ\", \"COMPRAS_RECEIPT_MANAGE\", \"ESTOQUE_PRODUCT_MANAGE\", \"ESTOQUE_WAREHOUSE_MANAGE\", \"ESTOQUE_WAREHOUSE_READ\"];",
                  "pm.test('Usuário tem as permissões do módulo', () => {",
                  "    const missing = required.filter(p => !perms.includes(p));",
                  "    pm.expect(missing, 'permissões faltando: ' + missing.join(', ')).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Rode esta pasta primeiro. O `accessToken` fica salvo na coleção e é reaproveitado por todas as outras requisições."
    },
    {
      "name": "01 — Pré-requisitos (domínio estoque)",
      "item": [
        {
          "name": "Criar depósito de recebimento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/warehouses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "warehouses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{warehouseCode}}\",\n  \"name\": \"Depósito de recebimento — Postman\",\n  \"type\": \"LOJA_FISICA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O recebimento precisa de um depósito existente; senão devolve 404 WAREHOUSE_NOT_FOUND."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('warehouseCode', 'PM-CMP-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Código confere',",
                  "    () => pm.expect(pm.response.json().code).to.eql(pm.collectionVariables.get('warehouseCode')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar produto que será recebido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Carvão de coco — teste Postman\",\n  \"category\": \"CARVAO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O SKU é texto livre nas movimentações (não há FK — ver EST-C002), mas cadastrar o produto mantém o cenário realista."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sku', 'PM-CMP-SKU-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('SKU confere',",
                  "    () => pm.expect(pm.response.json().sku).to.eql(pm.collectionVariables.get('sku')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Fornecedores",
      "item": [
        {
          "name": "Listar fornecedores (paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/compras/suppliers?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "compras",
                "suppliers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "`COMPRAS_READ`. Guarda o id do primeiro fornecedor em `{{supplierId}}` para as requisições de recebimento."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Estrutura de PageResult', () => {",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.page).to.eql(0);",
                  "    pm.expect(json.totalElements).to.be.a('number');",
                  "});",
                  "",
                  "if (json.content.length) {",
                  "    pm.collectionVariables.set('supplierId', json.content[0].id);",
                  "    console.log('supplierId = ' + json.content[0].id);",
                  "} else {",
                  "    pm.collectionVariables.set('supplierId', '');",
                  "    console.warn('Nenhum fornecedor cadastrado — as requisições de recebimento serão ignoradas. Veja o SQL na descrição da coleção.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: size acima do teto → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/compras/suppliers?page=0&size=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "compras",
                "suppliers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "500"
                }
              ]
            },
            "description": "O controller é `@Validated`: `size` aceita de 1 a 100 e `page` não pode ser negativo."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode = VALIDATION_ERROR',",
                  "    () => pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Recebimento de mercadoria",
      "item": [
        {
          "name": "Registrar recebimento (2 itens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/compras/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "compras",
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"warehouseCode\": \"{{warehouseCode}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 30\n    },\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 12\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "`COMPRAS_RECEIPT_MANAGE`. Cada item vira um `StockMovement` de `ENTRADA` com o motivo *Recebimento de mercadoria - fornecedor #id*. O ajuste de estoque acontece **antes** de persistir o documento, na mesma transação."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('supplierId')) {",
                  "    console.warn('Nenhum fornecedor cadastrado — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Documento devolvido com os 2 itens', () => {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.warehouseCode).to.eql(pm.collectionVariables.get('warehouseCode'));",
                  "    pm.expect(json.items).to.have.lengthOf(2);",
                  "    pm.expect(json.receivedAt).to.be.a('string');",
                  "});",
                  "pm.test('Usuário do recebimento é o autenticado',",
                  "    () => pm.expect(json.username).to.eql(pm.collectionVariables.get('username')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conferir a entrada no estoque",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/stock-balance?sku={{sku}}&warehouseCode={{warehouseCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "stock-balance"
              ],
              "query": [
                {
                  "key": "sku",
                  "value": "{{sku}}"
                },
                {
                  "key": "warehouseCode",
                  "value": "{{warehouseCode}}"
                }
              ]
            },
            "description": "Saldo esperado: 30 + 12 = 42 — a soma dos itens do recebimento."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('supplierId')) {",
                  "    console.warn('Nenhum fornecedor cadastrado — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Saldo é 42 (30 + 12)',",
                  "    () => pm.expect(Number(pm.response.json().quantity)).to.eql(42));"
                ]
              }
            }
          ]
        }
      ]
    },
