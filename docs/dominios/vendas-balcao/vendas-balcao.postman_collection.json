    {
      "name": "02 — Abertura de caixa",
      "item": [
        {
          "name": "Abrir caixa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ]
            },
            "description": "`PDV_SESSION_MANAGE`. Uma sessão aberta por operador — repetir devolve 409 SESSION_ALREADY_OPEN. O `warehouseCode` informado aqui vale para TODAS as vendas deste caixa: ele não vai mais no corpo da venda (PDV-C004).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"openingAmount\": 200.00,\n  \"warehouseCode\": \"{{warehouseCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.collectionVariables.set('sessionId', s.id);",
                  "pm.test('Abre com o fundo de troco informado', () => {",
                  "    pm.expect(s.status).to.eql('OPEN');",
                  "    pm.expect(Number(s.openingAmount)).to.eql(200);",
                  "    pm.expect(s.warehouseCode).to.eql(pm.collectionVariables.get('warehouseCode'));",
                  "});",
                  "pm.test('Sessão aberta ainda não tem conferência', () => {",
                  "    pm.expect(s.closedAt).to.be.null;",
                  "    pm.expect(s.countedAmount).to.be.null;",
                  "    pm.expect(s.diverges).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir segundo caixa para o mesmo operador → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ]
            },
            "description": "Uma sessão aberta por operador. A regra vale no domínio e no índice parcial único do schema (V66).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"openingAmount\": 50.00,\n  \"warehouseCode\": \"{{warehouseCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('errorCode SESSION_ALREADY_OPEN', () => pm.expect(pm.response.json().errorCode).to.eql('SESSION_ALREADY_OPEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Meu caixa aberto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions",
                "current"
              ]
            },
            "description": "`PDV_READ`. 404 NO_OPEN_SESSION quando o operador não tem caixa aberto."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('É a sessão recém-aberta', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('sessionId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar sessões de caixa (paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "`PDV_READ`. Guarda em `{{sessionId}}` a primeira sessão com status `OPEN` — vender em sessão `CLOSED` devolve 409."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Estrutura de PageResult', () => {",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.page).to.eql(0);",
                  "    pm.expect(json.totalElements).to.be.a('number');",
                  "});",
                  "",
                  "const aberta = json.content.find(s => s.status === 'OPEN');",
                  "if (aberta) {",
                  "    pm.collectionVariables.set('sessionId', aberta.id);",
                  "    console.log('sessionId = ' + aberta.id);",
                  "} else {",
                  "    pm.collectionVariables.set('sessionId', '');",
                  "    console.warn('Nenhuma sessão OPEN — as vendas serão ignoradas. Veja o SQL na descrição da coleção.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: page negativa → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions?page=-1&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "-1"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "O controller é `@Validated`: `page` ≥ 0 e `size` entre 1 e 100."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode = VALIDATION_ERROR',",
                  "    () => pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Venda no balcão",
      "item": [
        {
          "name": "Registrar venda (2 itens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions/{{sessionId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions",
                "{{sessionId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseCode\": \"{{warehouseCode}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2\n    },\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "`PDV_SALE_MANAGE`. Cada item vira um `StockMovement` de `SAIDA` com o motivo *Venda balcão sessão #id*. Total esperado: 2 × 25,50 + 1 × 10,00 = 61,00."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sessionId')) {",
                  "    console.warn('Nenhuma sessão de caixa aberta — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Venda devolvida com os 2 itens', () => {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(String(json.sessionId)).to.eql(String(pm.collectionVariables.get('sessionId')));",
                  "    pm.expect(json.items).to.have.lengthOf(2);",
                  "});",
                  "pm.test('Total calculado no servidor é 61.00',",
                  "    () => pm.expect(Number(json.totalAmount)).to.eql(61));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conferir a baixa no estoque",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
