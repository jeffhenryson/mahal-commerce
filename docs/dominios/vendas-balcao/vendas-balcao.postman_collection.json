    {
      "name": "02 — Sessões de caixa",
      "item": [
        {
          "name": "Listar sessões de caixa (paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "`PDV_READ`. Guarda em `{{sessionId}}` a primeira sessão com status `OPEN` — vender em sessão `CLOSED` devolve 409."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Estrutura de PageResult', () => {",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.page).to.eql(0);",
                  "    pm.expect(json.totalElements).to.be.a('number');",
                  "});",
                  "",
                  "const aberta = json.content.find(s => s.status === 'OPEN');",
                  "if (aberta) {",
                  "    pm.collectionVariables.set('sessionId', aberta.id);",
                  "    console.log('sessionId = ' + aberta.id);",
                  "} else {",
                  "    pm.collectionVariables.set('sessionId', '');",
                  "    console.warn('Nenhuma sessão OPEN — as vendas serão ignoradas. Veja o SQL na descrição da coleção.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: page negativa → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions?page=-1&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "-1"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "O controller é `@Validated`: `page` ≥ 0 e `size` entre 1 e 100."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode = VALIDATION_ERROR',",
                  "    () => pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Venda no balcão",
      "item": [
        {
          "name": "Registrar venda (2 itens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions/{{sessionId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions",
                "{{sessionId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseCode\": \"{{warehouseCode}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2,\n      \"unitPrice\": 25.5\n    },\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 1,\n      \"unitPrice\": 10.0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "`PDV_SALE_MANAGE`. Cada item vira um `StockMovement` de `SAIDA` com o motivo *Venda balcão sessão #id*. Total esperado: 2 × 25,50 + 1 × 10,00 = 61,00."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sessionId')) {",
                  "    console.warn('Nenhuma sessão de caixa aberta — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Venda devolvida com os 2 itens', () => {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(String(json.sessionId)).to.eql(String(pm.collectionVariables.get('sessionId')));",
                  "    pm.expect(json.items).to.have.lengthOf(2);",
                  "});",
                  "pm.test('Total calculado no servidor é 61.00',",
                  "    () => pm.expect(Number(json.totalAmount)).to.eql(61));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conferir a baixa no estoque",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/stock-balance?sku={{sku}}&warehouseCode={{warehouseCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "stock-balance"
              ],
              "query": [
                {
                  "key": "sku",
                  "value": "{{sku}}"
                },
                {
                  "key": "warehouseCode",
                  "value": "{{warehouseCode}}"
                }
              ]
            },
            "description": "Saldo esperado: 50 − 2 − 1 = 47."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sessionId')) {",
                  "    console.warn('Nenhuma sessão de caixa aberta — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Saldo é 47 (50 − 3)',",
                  "    () => pm.expect(Number(pm.response.json().quantity)).to.eql(47));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 — Casos de erro",
      "item": [
        {
          "name": "Erro: saldo insuficiente → 400 (venda inteira revertida)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions/{{sessionId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions",
                "{{sessionId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseCode\": \"{{warehouseCode}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 1,\n      \"unitPrice\": 25.5\n    },\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 9999,\n      \"unitPrice\": 25.5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O primeiro item tem saldo, o segundo não. Como a baixa acontece dentro da mesma transação, **nenhum** dos dois é gravado — confirme no próximo request."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sessionId')) {",
                  "    console.warn('Nenhuma sessão de caixa aberta — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode = INSUFFICIENT_STOCK',",
                  "    () => pm.expect(pm.response.json().errorCode).to.eql('INSUFFICIENT_STOCK'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conferir que a venda falha não mexeu no saldo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/stock-balance?sku={{sku}}&warehouseCode={{warehouseCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "stock-balance"
              ],
              "query": [
                {
                  "key": "sku",
                  "value": "{{sku}}"
                },
                {
                  "key": "warehouseCode",
                  "value": "{{warehouseCode}}"
                }
              ]
            },
            "description": "Saldo continua 47 — o rollback desfez a baixa do primeiro item."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sessionId')) {",
                  "    console.warn('Nenhuma sessão de caixa aberta — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Saldo continua 47',",
                  "    () => pm.expect(Number(pm.response.json().quantity)).to.eql(47));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: sessão de caixa inexistente → 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions/999999/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions",
                "999999",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseCode\": \"{{warehouseCode}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 1,\n      \"unitPrice\": 10.0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A sessão é validada antes de qualquer baixa de estoque."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('errorCode = CASH_REGISTER_SESSION_NOT_FOUND',",
                  "    () => pm.expect(pm.response.json().errorCode).to.eql('CASH_REGISTER_SESSION_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: venda sem itens → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions/{{sessionId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions",
                "{{sessionId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseCode\": \"{{warehouseCode}}\",\n  \"items\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "`items` é `@NotEmpty`."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sessionId')) {",
                  "    console.warn('Nenhuma sessão de caixa aberta — requisição ignorada. Veja o SQL na descrição da coleção.');",
                  "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode = VALIDATION_ERROR',",
                  "    () => pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sem token → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pdv/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pdv",
                "sessions"
              ]
            },
            "description": "Confirma que o endpoint está protegido: sem `Authorization` a resposta é 401.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Para exercitar o 409 `CASH_REGISTER_SESSION_CLOSED`, feche uma sessão pelo banco (`UPDATE cash_register_session SET status = 'CLOSED', closed_at = NOW() WHERE id = ...`) e aponte `{{sessionId}}` para ela."
    },
    {
      "name": "99 — Encerramento",
      "item": [
        {
          "name": "Logout (revoga o refresh token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Revoga o refresh token da sessão. O accessToken continua válido até expirar."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('refreshToken', '');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
