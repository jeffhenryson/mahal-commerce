            },
            "url": {
              "raw": "{{base_url}}/users/{{created_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{created_user_id}}"]
            },
            "description": "Atualiza o username de um usuário. Requer permissão USER_UPDATE (apenas ADMIN).\nUsa o ID salvo em {{created_user_id}} — execute **[Usuários] Criar novo usuário** primeiro.\nEndpoint: PATCH /users/{id}"
          }
        },
