                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"joao\",\n  \"password\": \"Senha@123\",\n  \"roles\": [\"ROLE_USER\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Cria um novo usuário com roles. Requer permissão USER_CREATE (apenas ADMIN).\nUsername: 3-80 chars | Password: 8-120 chars\nroles: opcional — ex: [\"ROLE_USER\"] ou [\"ROLE_ADMIN\"]\n\nO ID criado é salvo em {{created_user_id}} para reuso nos demais requests."
          }
        },
        {
          "name": "[Usuários] Atualizar username",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
